# LeadRadar 密钥配置（复制为 .env 后填写，config.json 里留空时从这里读取）
# 也可以不手工编辑：操作台的「密钥与代理」「邮箱」两张卡片会直接写这个文件。

# 搜索 API 三选一
SERPER_API_KEY=
BING_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# 大模型（AI 判断 + 自动写开发信；OpenAI 兼容接口，DeepSeek/通义/智谱/Kimi 都行）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 邮箱查找（找客户邮箱，可选）：none / hunter / apollo / snov
EMAIL_FINDER_PROVIDER=none
HUNTER_API_KEY=
APOLLO_API_KEY=
SNOV_USER_ID=
SNOV_SECRET=

# 你的发信邮箱（可选）：在操作台「邮箱」卡片点「登录测试」成功后自动写入这一组
# 多数邮箱要填「授权码 / 应用专用密码」，不是网页登录密码
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_FROM=
SMTP_NAME=

# Gmail 专用：不用应用密码，改用 Google 账号 OAuth（XOAUTH2）
# 在操作台「邮箱」卡片里点「用 Google 账号授权」会引导你创建下面两项，并自动写入令牌
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_EMAIL=

# 可覆盖 Chrome 路径（无头抓取备用）
CHROME_PATH=

# 代理（访问 Instagram/TikTok 等海外站点用；填本地代理地址，如 Clash 默认 7890）
HTTPS_PROXY=http://127.0.0.1:7890
